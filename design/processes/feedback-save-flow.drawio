<mxfile host="Electron">
  <diagram id="FeedbackSaveFlow" name="Feedback save flow">
    <mxGraphModel dx="1030" dy="756" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="start" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;fontColor=#ffffff;strokeColor=#000000;fontSize=11;fontStyle=1;" value="Start" vertex="1">
          <mxGeometry height="50" width="50" x="105" y="20" as="geometry" />
        </mxCell>
        <mxCell id="submit" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" value="Visitor submits the Contact Us form" vertex="1">
          <mxGeometry height="50" width="160" x="50" y="100" as="geometry" />
        </mxCell>
        <mxCell id="browserCheck" parent="1" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;" value="Browser validation passes?" vertex="1">
          <mxGeometry height="90" width="160" x="50" y="190" as="geometry" />
        </mxCell>
        <mxCell id="fieldErrors" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" value="Show field errors and focus the first invalid field. Nothing is sent" vertex="1">
          <mxGeometry height="70" width="180" x="300" y="200" as="geometry" />
        </mxCell>
        <mxCell id="send" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" value="Disable the Send button and POST the entry to /api/feedback of the save service" vertex="1">
          <mxGeometry height="70" width="180" x="40" y="330" as="geometry" />
        </mxCell>
        <mxCell id="originCheck" parent="1" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;" value="Origin allowed? (none, null, localhost)" vertex="1">
          <mxGeometry height="100" width="180" x="40" y="440" as="geometry" />
        </mxCell>
        <mxCell id="rejectOrigin" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" value="403 Origin not allowed. Nothing stored" vertex="1">
          <mxGeometry height="60" width="180" x="300" y="460" as="geometry" />
        </mxCell>
        <mxCell id="serviceCheck" parent="1" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;" value="Service validation passes? (same rules)" vertex="1">
          <mxGeometry height="100" width="180" x="40" y="580" as="geometry" />
        </mxCell>
        <mxCell id="reject400" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" value="400 with field errors (or 413 when the body is too large). Nothing stored" vertex="1">
          <mxGeometry height="70" width="180" x="300" y="595" as="geometry" />
        </mxCell>
        <mxCell id="append" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" value="Append the record (id, savedAt, name, email, subject, rating, comment) to tmp/feedback/feedback.json" vertex="1">
          <mxGeometry height="80" width="180" x="40" y="720" as="geometry" />
        </mxCell>
        <mxCell id="storeCheck" parent="1" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;" value="File written?" vertex="1">
          <mxGeometry height="80" width="140" x="560" y="720" as="geometry" />
        </mxCell>
        <mxCell id="reject500" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" value="500 Could not save. Damaged or unwritable file stays untouched" vertex="1">
          <mxGeometry height="70" width="180" x="780" y="715" as="geometry" />
        </mxCell>
        <mxCell id="created" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" value="201 Created with the record id" vertex="1">
          <mxGeometry height="60" width="160" x="560" y="590" as="geometry" />
        </mxCell>
        <mxCell id="successAlert" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" value="Success alert, form cleared, Send button enabled" vertex="1">
          <mxGeometry height="60" width="180" x="780" y="590" as="geometry" />
        </mxCell>
        <mxCell id="failureAlert" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" value="Any other answer, or no answer (service stopped): failure alert, typed values kept, Send button enabled" vertex="1">
          <mxGeometry height="90" width="200" x="780" y="450" as="geometry" />
        </mxCell>
        <mxCell id="e1" parent="1" style="endArrow=classic;html=1;" edge="1" source="start" target="submit"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" parent="1" style="endArrow=classic;html=1;" edge="1" source="submit" target="browserCheck"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" parent="1" style="endArrow=classic;html=1;" edge="1" source="browserCheck" target="fieldErrors" value="no"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" parent="1" style="endArrow=classic;html=1;" edge="1" source="browserCheck" target="send" value="yes"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" parent="1" style="endArrow=classic;html=1;" edge="1" source="send" target="originCheck"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" parent="1" style="endArrow=classic;html=1;" edge="1" source="originCheck" target="rejectOrigin" value="no"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" parent="1" style="endArrow=classic;html=1;" edge="1" source="originCheck" target="serviceCheck" value="yes"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" parent="1" style="endArrow=classic;html=1;" edge="1" source="serviceCheck" target="reject400" value="no"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" parent="1" style="endArrow=classic;html=1;" edge="1" source="serviceCheck" target="append" value="yes"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" parent="1" style="endArrow=classic;html=1;" edge="1" source="append" target="storeCheck"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" parent="1" style="endArrow=classic;html=1;" edge="1" source="storeCheck" target="reject500" value="no"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e12" parent="1" style="endArrow=classic;html=1;" edge="1" source="storeCheck" target="created" value="yes"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e13" parent="1" style="endArrow=classic;html=1;" edge="1" source="created" target="successAlert"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e14" parent="1" style="endArrow=classic;html=1;dashed=1;" edge="1" source="rejectOrigin" target="failureAlert"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e15" parent="1" style="endArrow=classic;html=1;dashed=1;" edge="1" source="reject400" target="failureAlert"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e16" parent="1" style="endArrow=classic;html=1;dashed=1;" edge="1" source="reject500" target="failureAlert"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
